{ The data API of DBWare: REST resources over tables and views, with the SQL
  generated by RAL from the catalog (list, get, insert, update, patch, delete),
  filters in the URL, paging, optimistic concurrency, roles and tenants. }
unit RALDBCrudModule;

{$I ..\core\PascalRAL.inc}

interface

uses
  Classes, SysUtils, DB, SyncObjs, Contnrs, DateUtils,
  RALTypes, RALConsts, RALMIMETypes, RALTools, RALBase64, RALJson, RALServer, RALRoutes,
  RALRequest, RALResponse, RALParams, RALStorage, RALDBBase, RALDBPool, RALDBModule, RALDBCatalog,
  RALDBFilter;

type
  /// An operation a resource answers.
  TRALDBCrudOperation = (roList, roGet, roInsert, roUpdate, roPatch, roDelete);
  /// A set of operations.
  TRALDBCrudOperations = set of TRALDBCrudOperation;

  { Where the data of each tenant lives: no tenants, a column of every table,
    a schema of one database, or a database of its own. }
  TRALDBTenantMode = (tmNone, tmColumn, tmSchema, tmDatabase);

  TRALDBCrudResource = class;

  { Fired before a write of AResource: AValues holds what goes to the table
    (insert, update) or the key (delete); change it, or set AAllow False to
    refuse with 403. }
  TRALDBCrudBeforeEvent = procedure(Sender: TObject; ARequest: TRALRequest;
    AResource: TRALDBCrudResource; AValues: TRALJSONObject; var AAllow: Boolean) of object;
  { Fired after a write of AResource; ARecord is the row as it is now (nil after
    a delete). }
  TRALDBCrudAfterEvent = procedure(Sender: TObject; ARequest: TRALRequest;
    AResource: TRALDBCrudResource; ARecord: TRALJSONObject) of object;
  /// Gives the tenant of ARequest; empty refuses the request with 403.
  TRALDBTenantEvent = procedure(Sender: TObject; ARequest: TRALRequest;
    var ATenant: StringRAL) of object;
  { Points ADatabase, a new driver configured like the linked TRALDBModule, at
    the database of ATenant (tmDatabase). }
  TRALDBTenantDatabaseEvent = procedure(Sender: TObject; const ATenant: StringRAL;
    ADatabase: TRALDBBase) of object;

  /// A table or view served as a REST resource.
  TRALDBCrudResource = class(TCollectionItem)
  private
    FBaseFilter: StringRAL;
    FDefaultSort: StringRAL;
    FFields: TStrings;
    FHiddenFields: TStrings;
    /// The catalog of the table, kept for CatalogLife; owned.
    FInfo: TRALDBTableInfo;
    /// When FInfo was read.
    FInfoTime: TDateTime;
    FKeyFields: StringRAL;
    FMaxPageSize: IntegerRAL;
    FOnAfterWrite: TRALDBCrudAfterEvent;
    FOnBeforeDelete: TRALDBCrudBeforeEvent;
    FOnBeforeInsert: TRALDBCrudBeforeEvent;
    FOnBeforeUpdate: TRALDBCrudBeforeEvent;
    FOperations: TRALDBCrudOperations;
    FReadOnlyFields: TStrings;
    FReadRoles: StringRAL;
    FRoles: StringRAL;
    FRoute: StringRAL;
    FSelectSQL: StringRAL;
    FTableName: StringRAL;
    FTenantField: StringRAL;
    FVersionField: StringRAL;
    FWriteRoles: StringRAL;

    procedure SetFields(AValue: TStrings);
    procedure SetHiddenFields(AValue: TStrings);
    procedure SetReadOnlyFields(AValue: TStrings);
  protected
    function GetDisplayName: string; override;
  public
    constructor Create(ACollection: TCollection); override;
    destructor Destroy; override;

    procedure Assign(ASource: TPersistent); override;
    /// Whether the column AName may be read through the resource.
    function CanRead(const AName: StringRAL): Boolean;
    /// Whether the column AName may be written through the resource.
    function CanWrite(AColumn: TRALDBColumnInfo): Boolean;
  published
    { A SQL condition (trusted, written by the developer) added to every
      statement of the resource, such as active = 1. }
    property BaseFilter: StringRAL read FBaseFilter write FBaseFilter;
    /// The order of lists with no _sort, as _sort writes it (-price,name).
    property DefaultSort: StringRAL read FDefaultSort write FDefaultSort;
    /// The columns served, one per line; empty = all but HiddenFields.
    property Fields: TStrings read FFields write SetFields;
    /// Columns never read nor written through the resource.
    property HiddenFields: TStrings read FHiddenFields write SetHiddenFields;
    { The key columns, separated by commas; empty = the primary key of the
      catalog. A composite key travels as 1,ABC in the URL. }
    property KeyFields: StringRAL read FKeyFields write FKeyFields;
    /// The most rows a list answers at once.
    property MaxPageSize: IntegerRAL read FMaxPageSize write FMaxPageSize default 100;
    /// Fired after an insert, update, patch or delete.
    property OnAfterWrite: TRALDBCrudAfterEvent read FOnAfterWrite write FOnAfterWrite;
    /// Fired before a delete.
    property OnBeforeDelete: TRALDBCrudBeforeEvent read FOnBeforeDelete write FOnBeforeDelete;
    /// Fired before an insert.
    property OnBeforeInsert: TRALDBCrudBeforeEvent read FOnBeforeInsert write FOnBeforeInsert;
    /// Fired before an update or a patch.
    property OnBeforeUpdate: TRALDBCrudBeforeEvent read FOnBeforeUpdate write FOnBeforeUpdate;
    /// The operations answered.
    property Operations: TRALDBCrudOperations read FOperations write FOperations
      default [roList, roGet, roInsert, roUpdate, roPatch, roDelete];
    /// Columns read but never written.
    property ReadOnlyFields: TStrings read FReadOnlyFields write SetReadOnlyFields;
    /// Roles that may read (any of them, separated by commas); empty = Roles.
    property ReadRoles: StringRAL read FReadRoles write FReadRoles;
    /// Roles that may use the resource at all; empty = everyone.
    property Roles: StringRAL read FRoles write FRoles;
    /// The path of the resource, such as /clients.
    property Route: StringRAL read FRoute write FRoute;
    { A select of its own (read only) in place of the table; filters, order and
      paging apply to its columns. }
    property SelectSQL: StringRAL read FSelectSQL write FSelectSQL;
    /// The table or view (schema.name allowed).
    property TableName: StringRAL read FTableName write FTableName;
    /// The column that holds the tenant, with TenantMode tmColumn.
    property TenantField: StringRAL read FTenantField write FTenantField;
    { An integer column that grows by one on every write: its value is the
      ETag, and If-Match with another value is answered 412. }
    property VersionField: StringRAL read FVersionField write FVersionField;
    /// Roles that may write (any of them, separated by commas); empty = Roles.
    property WriteRoles: StringRAL read FWriteRoles write FWriteRoles;
  end;

  /// The resources of a data API module.
  TRALDBCrudResources = class(TOwnedCollection)
  private
    function GetItem(AIndex: IntegerRAL): TRALDBCrudResource;
  public
    /// Adds the resource of ATable at ARoute and returns it.
    function AddResource(const ARoute, ATable: StringRAL): TRALDBCrudResource;

    /// The resources by position.
    property Items[AIndex: IntegerRAL]: TRALDBCrudResource read GetItem; default;
  end;

  /// A route of a resource; the item route ends in /:ral_key.
  TRALDBCrudRoute = class(TRALRoute)
  private
    FResource: TRALDBCrudResource;
  public
    /// The resource the route serves.
    property Resource: TRALDBCrudResource read FResource write FResource;
  end;

  { Serves Resources over the database of DBModule (its driver and pool): GET
    and POST on the route, GET, PUT, PATCH and DELETE on route/key. Every SQL is
    generated with params, and every name of the URL goes through the catalog. }
  TRALDBCrudModule = class(TRALModuleRoutes)
  private
    FCatalogLife: IntegerRAL;
    FDBModule: TRALDBModule;
    FFilterSyntaxes: TRALDBFilterSyntaxes;
    /// Guards FTenantPools and the catalogs.
    FLock: TCriticalSection;
    FOnGetTenant: TRALDBTenantEvent;
    FOnGetTenantDatabase: TRALDBTenantDatabaseEvent;
    FResources: TRALDBCrudResources;
    FStorage: TRALStorageLink;
    FTenantClaim: StringRAL;
    FTenantHeader: StringRAL;
    FTenantIdle: IntegerRAL;
    FTenantMode: TRALDBTenantMode;
    /// The pools of the tenants (tmDatabase), objects by tenant name; owned.
    FTenantPools: TStringList;
    FTotalCount: Boolean;

    /// The database for ARequest and ATenant; release with ReleaseFor.
    function AcquireFor(ARequest: TRALRequest; AResponse: TRALResponse;
      const ATenant: StringRAL): TRALDBBase;
    /// Answers AStatus with an RFC 9457 problem of ADetail.
    procedure AnswerProblem(AResponse: TRALResponse; AStatus: IntegerRAL; const ADetail: StringRAL);
    /// Creates a driver for the tenant pool ASender.
    function CreateTenantConnection(ASender: TObject): TRALDBBase;
    /// Frees the tenant pools idle for longer than TenantIdle.
    procedure DropIdleTenants;
    /// The catalog of AResource on ADatabase, from the cache when fresh.
    function InfoOf(AResource: TRALDBCrudResource; ADatabase: TRALDBBase): TRALDBTableInfo;
    /// The key columns of AResource.
    function KeyColumns(AResource: TRALDBCrudResource; AInfo: TRALDBTableInfo): TStringList;
    /// Gives back ADatabase taken by AcquireFor.
    procedure ReleaseFor(ADatabase: TRALDBBase; const ATenant: StringRAL);
    /// Answers a request of a resource.
    procedure Reply(ARequest: TRALRequest; AResponse: TRALResponse);
    procedure SetDBModule(AValue: TRALDBModule);
    procedure SetResources(AValue: TRALDBCrudResources);
    procedure SetStorage(AValue: TRALStorageLink);
    /// The tenant of ARequest; '' when TenantMode is tmNone.
    function TenantOf(ARequest: TRALRequest): StringRAL;
  protected
    procedure Notification(AComponent: TComponent; Operation: TOperation); override;
    class function RouteClass: TRALRouteClass; override;
    procedure ServerActivating; override;
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;

    function DefaultContentType: StringRAL; override;
    /// Rebuilds the routes from Resources (done when the server starts).
    procedure RefreshRoutes;
  published
    /// Minutes the catalog of a table is kept; 0 = read on every request.
    property CatalogLife: IntegerRAL read FCatalogLife write FCatalogLife default 10;
    /// The DBWare module whose driver, connection and pool the resources use.
    property DBModule: TRALDBModule read FDBModule write SetDBModule;
    { The filter syntaxes taken from the URL: simple (name_gt=10) and RQL
      (rql=and(eq(a,1),gt(b,2))); a request picks with filter-syntax or the
      X-RAL-Filter-Syntax header. }
    property FilterSyntaxes: TRALDBFilterSyntaxes read FFilterSyntaxes write FFilterSyntaxes
      default [fsSimple, fsRQL];
    /// Gives the tenant of a request (default: TenantClaim, then TenantHeader).
    property OnGetTenant: TRALDBTenantEvent read FOnGetTenant write FOnGetTenant;
    /// Points a new driver at the database of a tenant (tmDatabase).
    property OnGetTenantDatabase: TRALDBTenantDatabaseEvent read FOnGetTenantDatabase
      write FOnGetTenantDatabase;
    /// The resources.
    property Resources: TRALDBCrudResources read FResources write SetResources;
    { A storage that answers lists and records when the client accepts its
      content type; JSON otherwise. }
    property Storage: TRALStorageLink read FStorage write SetStorage;
    /// The claim of the identity that names the tenant.
    property TenantClaim: StringRAL read FTenantClaim write FTenantClaim;
    /// A header that names the tenant when the identity has no claim; empty = none.
    property TenantHeader: StringRAL read FTenantHeader write FTenantHeader;
    /// Seconds a tenant pool (tmDatabase) may stay unused before it is freed.
    property TenantIdle: IntegerRAL read FTenantIdle write FTenantIdle default 600;
    /// Where the data of each tenant lives.
    property TenantMode: TRALDBTenantMode read FTenantMode write FTenantMode default tmNone;
    /// Answers X-Total-Count on lists (one more COUNT per list).
    property TotalCount: Boolean read FTotalCount write FTotalCount default False;
  end;

implementation

type
  /// The pool of one tenant.
  TRALDBTenantPool = class
  public
    /// When the pool was last used.
    LastUse: TDateTime;
    /// The pool.
    Pool: TRALDBConnectionPool;
    /// The tenant.
    Tenant: StringRAL;

    destructor Destroy; override;
  end;

const
  /// The route parameter of a key.
  cKeyParam = 'ral_key';
  /// HTTP status 409 Conflict.
  cHTTPConflict = 409;
  /// HTTP status 412 Precondition Failed.
  cHTTPPreconditionFailed = 412;

/// AText of the RTL's string type as StringRAL.
function ToRAL(const AText: string): StringRAL;
begin
  {$IFDEF FPC}
  Result := AText;
  {$ELSE}
  Result := UTF8Encode(AText);
  {$ENDIF}
end;

/// StringRAL AText as the RTL's string type.
function FromRAL(const AText: StringRAL): string;
begin
  {$IFDEF FPC}
  Result := AText;
  {$ELSE}
  Result := UTF8ToString(AText);
  {$ENDIF}
end;

/// Whether the list AList holds AName, case-insensitive.
function Listed(AList: TStrings; const AName: StringRAL): Boolean;
var
  vInt: IntegerRAL;
begin
  for vInt := 0 to AList.Count - 1 do
    if RALSameName(ToRAL(AList[vInt]), AName) then
    begin
      Result := True;
      Exit;
    end;
  Result := False;
end;

/// The value of AField as JSON; the caller owns it.
function FieldJSON(AField: TField): TRALJSON;
var
  vBytes: TBytes;
begin
  if AField.IsNull then
    Result := TRALJSONNull.Create
  else
    case AField.DataType of
      ftBoolean:
        Result := TRALJSONBoolean.Create(AField.AsBoolean);
      ftSmallint, ftInteger, ftWord, ftLargeint, ftAutoInc:
        Result := TRALJSONNumber.Create(StringRAL(IntToStr(AField.AsLargeInt)));
      ftFloat, ftCurrency, ftBCD, ftFMTBcd:
        Result := TRALJSONNumber.Create(StringRAL(FloatToStr(AField.AsFloat, RALInvariantFormat)));
      ftDate, ftTime, ftDateTime, ftTimeStamp:
        Result := TRALJSONString.Create(RALDateTimeToISO8601(AField.AsDateTime, True));
      ftBlob, ftGraphic, ftVarBytes, ftBytes:
      begin
        vBytes := AField.AsBytes;
        Result := TRALJSONString.Create(TRALBase64.Encode(vBytes));
      end;
    else
      Result := TRALJSONString.Create(ToRAL(AField.AsString));
    end;
end;

/// The current record of ADataset as a JSON object, only the fields of ANames.
function RecordJSON(ADataset: TDataSet): TRALJSONObject;
var
  vInt: IntegerRAL;
begin
  Result := TRALJSONObject.Create;
  for vInt := 0 to ADataset.FieldCount - 1 do
    Result.Add(ToRAL(ADataset.Fields[vInt].FieldName), FieldJSON(ADataset.Fields[vInt]));
end;

/// Sets AParam to the JSON AValue, typed by AColumn.
procedure SetParamJSON(AParam: TParam; AColumn: TRALDBColumnInfo; AValue: TRALJSON);
begin
  if (AValue = nil) or AValue.IsNull then
  begin
    AParam.DataType := AColumn.DataType;
    if AParam.DataType in [ftBCD, ftFMTBcd, ftCurrency] then
      AParam.DataType := ftFloat;
    if AParam.DataType = ftMemo then
      AParam.DataType := ftString;
    AParam.Clear;
    Exit;
  end;
  case AValue.Kind of
    rjkBoolean:
      if AValue.AsBoolean then
        RALDBSetParamValue(AParam, AColumn, 'true')
      else
        RALDBSetParamValue(AParam, AColumn, 'false');
    rjkNumber:
      RALDBSetParamValue(AParam, AColumn, TRALJSONNumber(AValue).Value);
    rjkString:
      RALDBSetParamValue(AParam, AColumn, AValue.AsString);
  else
    raise ERALDBFilterError.CreateFmt('Invalid value for %s', [string(AColumn.Name)]);
  end;
end;

{ TRALDBTenantPool }

destructor TRALDBTenantPool.Destroy;
begin
  Pool.Free;
  inherited Destroy;
end;

{ TRALDBCrudResource }

constructor TRALDBCrudResource.Create(ACollection: TCollection);
begin
  inherited Create(ACollection);
  FFields := TStringList.Create;
  FHiddenFields := TStringList.Create;
  FReadOnlyFields := TStringList.Create;
  FMaxPageSize := 100;
  FOperations := [roList, roGet, roInsert, roUpdate, roPatch, roDelete];
end;

destructor TRALDBCrudResource.Destroy;
begin
  FFields.Free;
  FHiddenFields.Free;
  FReadOnlyFields.Free;
  FInfo.Free;
  inherited Destroy;
end;

procedure TRALDBCrudResource.Assign(ASource: TPersistent);
var
  vSource: TRALDBCrudResource;
begin
  if ASource is TRALDBCrudResource then
  begin
    vSource := TRALDBCrudResource(ASource);
    FRoute := vSource.Route;
    FTableName := vSource.TableName;
    FKeyFields := vSource.KeyFields;
    FOperations := vSource.Operations;
    FFields.Assign(vSource.Fields);
    FHiddenFields.Assign(vSource.HiddenFields);
    FReadOnlyFields.Assign(vSource.ReadOnlyFields);
    FRoles := vSource.Roles;
    FReadRoles := vSource.ReadRoles;
    FWriteRoles := vSource.WriteRoles;
    FMaxPageSize := vSource.MaxPageSize;
    FDefaultSort := vSource.DefaultSort;
    FBaseFilter := vSource.BaseFilter;
    FTenantField := vSource.TenantField;
    FSelectSQL := vSource.SelectSQL;
    FVersionField := vSource.VersionField;
    FOnBeforeInsert := vSource.OnBeforeInsert;
    FOnBeforeUpdate := vSource.OnBeforeUpdate;
    FOnBeforeDelete := vSource.OnBeforeDelete;
    FOnAfterWrite := vSource.OnAfterWrite;
  end
  else
    inherited Assign(ASource);
end;

function TRALDBCrudResource.CanRead(const AName: StringRAL): Boolean;
begin
  Result := not Listed(FHiddenFields, AName) and ((FFields.Count = 0) or Listed(FFields, AName));
end;

function TRALDBCrudResource.CanWrite(AColumn: TRALDBColumnInfo): Boolean;
begin
  Result := CanRead(AColumn.Name) and not AColumn.AutoIncrement and
    not Listed(FReadOnlyFields, AColumn.Name) and not RALSameName(AColumn.Name, FVersionField) and
    not RALSameName(AColumn.Name, FTenantField) and (FSelectSQL = '');
end;

function TRALDBCrudResource.GetDisplayName: string;
begin
  if FRoute = '' then
    Result := inherited GetDisplayName
  else
    Result := FromRAL(FRoute);
end;

procedure TRALDBCrudResource.SetFields(AValue: TStrings);
begin
  FFields.Assign(AValue);
end;

procedure TRALDBCrudResource.SetHiddenFields(AValue: TStrings);
begin
  FHiddenFields.Assign(AValue);
end;

procedure TRALDBCrudResource.SetReadOnlyFields(AValue: TStrings);
begin
  FReadOnlyFields.Assign(AValue);
end;

{ TRALDBCrudResources }

function TRALDBCrudResources.AddResource(const ARoute, ATable: StringRAL): TRALDBCrudResource;
begin
  Result := TRALDBCrudResource(Add);
  Result.Route := ARoute;
  Result.TableName := ATable;
end;

function TRALDBCrudResources.GetItem(AIndex: IntegerRAL): TRALDBCrudResource;
begin
  Result := TRALDBCrudResource(inherited Items[AIndex]);
end;

{ TRALDBCrudModule }

constructor TRALDBCrudModule.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FResources := TRALDBCrudResources.Create(Self, TRALDBCrudResource);
  FLock := TCriticalSection.Create;
  FTenantPools := TStringList.Create;
  FTenantPools.Sorted := True;
  FCatalogLife := 10;
  FFilterSyntaxes := [fsSimple, fsRQL];
  FTenantClaim := 'tenant';
  FTenantIdle := 600;
end;

destructor TRALDBCrudModule.Destroy;
var
  vInt: IntegerRAL;
begin
  for vInt := 0 to FTenantPools.Count - 1 do
    FTenantPools.Objects[vInt].Free;
  FTenantPools.Free;
  FResources.Free;
  FLock.Free;
  inherited Destroy;
end;

function TRALDBCrudModule.AcquireFor(ARequest: TRALRequest; AResponse: TRALResponse;
  const ATenant: StringRAL): TRALDBBase;
var
  vIndex: IntegerRAL;
  vPool: TRALDBTenantPool;
  vSQL: StringRAL;
  vRows, vLast: Int64RAL;
begin
  if FTenantMode <> tmDatabase then
  begin
    Result := FDBModule.AcquireDatabase(ARequest, AResponse);
    if FTenantMode = tmSchema then
    begin
      // The schema of the tenant, set on the connection and undone on release.
      case Result.DatabaseType of
        dtPostgreSQL: vSQL := 'set search_path to ' + RALDBDialect(dtPostgreSQL).Quote(ATenant);
        dtMySQL: vSQL := 'use ' + RALDBDialect(dtMySQL).Quote(ATenant);
      else
        FDBModule.ReleaseDatabase(Result);
        raise ERALDBFilterError.Create('Schema tenants need PostgreSQL or MySQL');
      end;
      vRows := 0;
      vLast := 0;
      Result.ExecSQL(vSQL, nil, vRows, vLast);
    end;
    Exit;
  end;
  DropIdleTenants;
  FLock.Enter;
  try
    vIndex := FTenantPools.IndexOf(FromRAL(ATenant));
    if vIndex < 0 then
    begin
      vPool := TRALDBTenantPool.Create;
      vPool.Tenant := ATenant;
      vPool.Pool := TRALDBConnectionPool.Create;
      vPool.Pool.Options.Assign(FDBModule.PoolOptions);
      vPool.Pool.OnCreateConnection := {$IFDEF FPC}@{$ENDIF}CreateTenantConnection;
      FTenantPools.AddObject(FromRAL(ATenant), vPool);
    end
    else
      vPool := TRALDBTenantPool(FTenantPools.Objects[vIndex]);
    vPool.LastUse := Now;
  finally
    FLock.Leave;
  end;
  Result := vPool.Pool.Acquire(ARequest, AResponse);
end;

procedure TRALDBCrudModule.AnswerProblem(AResponse: TRALResponse; AStatus: IntegerRAL;
  const ADetail: StringRAL);
var
  vProblem: TRALJSONObject;
begin
  vProblem := TRALJSONObject.Create;
  try
    vProblem.Add('status', Int64(AStatus));
    vProblem.Add('detail', ADetail);
    AResponse.Answer(AStatus, vProblem.ToJSON, 'application/problem+json');
  finally
    vProblem.Free;
  end;
end;

function TRALDBCrudModule.CreateTenantConnection(ASender: TObject): TRALDBBase;
var
  vClass: TRALDBClass;
  vInt: IntegerRAL;
  vTenant: StringRAL;
begin
  vClass := GetDatabaseClass(StringRAL(FDBModule.DatabaseLink));
  if vClass = nil then
    raise ERALDBFilterError.Create('DBModule.DatabaseLink names no driver');
  Result := vClass.Create;
  try
    Result.DatabaseType := FDBModule.DatabaseType;
    Result.Database := FDBModule.Database;
    Result.Hostname := FDBModule.Hostname;
    Result.Username := FDBModule.Username;
    Result.Password := FDBModule.Password;
    Result.Port := FDBModule.Port;
    Result.LibLocation := StringRAL(FDBModule.LibLocation);
    Result.CharacterSet := FDBModule.CharacterSet;
    if FDBModule.ConnectionParams.Count > 0 then
      Result.ConnectionParams := FDBModule.ConnectionParams;
    vTenant := '';
    FLock.Enter;
    try
      for vInt := 0 to FTenantPools.Count - 1 do
        if TRALDBTenantPool(FTenantPools.Objects[vInt]).Pool = ASender then
          vTenant := TRALDBTenantPool(FTenantPools.Objects[vInt]).Tenant;
    finally
      FLock.Leave;
    end;
    if Assigned(FOnGetTenantDatabase) then
      FOnGetTenantDatabase(Self, vTenant, Result);
  except
    Result.Free;
    raise;
  end;
end;

function TRALDBCrudModule.DefaultContentType: StringRAL;
begin
  Result := rctAPPLICATIONJSON;
end;

procedure TRALDBCrudModule.DropIdleTenants;
var
  vInt: IntegerRAL;
  vPool: TRALDBTenantPool;
begin
  FLock.Enter;
  try
    for vInt := FTenantPools.Count - 1 downto 0 do
    begin
      vPool := TRALDBTenantPool(FTenantPools.Objects[vInt]);
      if (SecondsBetween(Now, vPool.LastUse) > FTenantIdle) and (vPool.Pool.InUseCount = 0) then
      begin
        FTenantPools.Delete(vInt);
        vPool.Free;
      end;
    end;
  finally
    FLock.Leave;
  end;
end;

function TRALDBCrudModule.InfoOf(AResource: TRALDBCrudResource;
  ADatabase: TRALDBBase): TRALDBTableInfo;
var
  vQuery: TDataSet;
  vInt: IntegerRAL;
  vColumn: TRALDBColumnInfo;
begin
  FLock.Enter;
  try
    if (AResource.FInfo <> nil) and (FCatalogLife > 0) and
      (MinutesBetween(Now, AResource.FInfoTime) < FCatalogLife) then
    begin
      Result := AResource.FInfo;
      Exit;
    end;
  finally
    FLock.Leave;
  end;
  if AResource.SelectSQL <> '' then
  begin
    // A select of its own: the columns come from its empty result.
    vQuery := ADatabase.OpenCompatible('select * from (' + AResource.SelectSQL +
      ') ral_q where 1 = 0', nil);
    try
      Result := TRALDBTableInfo.Create;
      for vInt := 0 to vQuery.FieldCount - 1 do
      begin
        vColumn := Result.AddColumn(ToRAL(vQuery.Fields[vInt].FieldName));
        vColumn.DataType := vQuery.Fields[vInt].DataType;
      end;
    finally
      vQuery.Free;
    end;
  end
  else
    Result := RALDBTableInfo(ADatabase, AResource.TableName);
  if Result = nil then
    raise ERALDBFilterError.CreateFmt('Table %s not found', [FromRAL(AResource.TableName)]);
  FLock.Enter;
  try
    // The previous catalog may be in use by another request: it is kept until
    // the module goes, only the newest is looked up.
    AResource.FInfo.Free;
    AResource.FInfo := Result;
    AResource.FInfoTime := Now;
  finally
    FLock.Leave;
  end;
end;

function TRALDBCrudModule.KeyColumns(AResource: TRALDBCrudResource;
  AInfo: TRALDBTableInfo): TStringList;
begin
  Result := TStringList.Create;
  if AResource.KeyFields <> '' then
    Result.CommaText := FromRAL(AResource.KeyFields)
  else
    Result.CommaText := FromRAL(AInfo.KeyFields);
end;

procedure TRALDBCrudModule.Notification(AComponent: TComponent; Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if Operation = opRemove then
  begin
    if AComponent = FDBModule then
      FDBModule := nil;
    if AComponent = FStorage then
      FStorage := nil;
  end;
end;

procedure TRALDBCrudModule.RefreshRoutes;
var
  vInt: IntegerRAL;
  vRoute: TRALDBCrudRoute;
  vPath: StringRAL;
  vResource: TRALDBCrudResource;
begin
  Routes.Clear;
  for vInt := 0 to FResources.Count - 1 do
  begin
    vResource := FResources[vInt];
    vPath := vResource.Route;
    if vPath = '' then
      vPath := '/' + vResource.TableName;
    vRoute := TRALDBCrudRoute(CreateRoute(vPath, {$IFDEF FPC}@{$ENDIF}Reply));
    vRoute.Resource := vResource;
    vRoute.AllowedMethods := [amGET, amPOST];
    vRoute := TRALDBCrudRoute(CreateRoute(vPath + '/:' + cKeyParam, {$IFDEF FPC}@{$ENDIF}Reply));
    vRoute.Resource := vResource;
    vRoute.AllowedMethods := [amGET, amPUT, amPATCH, amDELETE];
  end;
end;

procedure TRALDBCrudModule.ReleaseFor(ADatabase: TRALDBBase; const ATenant: StringRAL);
var
  vIndex: IntegerRAL;
  vRows, vLast: Int64RAL;
  vPool: TRALDBTenantPool;
begin
  if FTenantMode <> tmDatabase then
  begin
    if FTenantMode = tmSchema then
    begin
      vRows := 0;
      vLast := 0;
      try
        if ADatabase.DatabaseType = dtPostgreSQL then
          ADatabase.ExecSQL('reset search_path', nil, vRows, vLast)
        else if FDBModule.Database <> '' then
          ADatabase.ExecSQL('use ' + RALDBDialect(dtMySQL).Quote(FDBModule.Database), nil,
            vRows, vLast);
      except
        // The pool drops a connection that fails its next validation.
      end;
    end;
    FDBModule.ReleaseDatabase(ADatabase);
    Exit;
  end;
  vPool := nil;
  FLock.Enter;
  try
    vIndex := FTenantPools.IndexOf(FromRAL(ATenant));
    if vIndex >= 0 then
    begin
      vPool := TRALDBTenantPool(FTenantPools.Objects[vIndex]);
      vPool.LastUse := Now;
    end;
  finally
    FLock.Leave;
  end;
  if vPool <> nil then
    vPool.Pool.Release(ADatabase)
  else
    ADatabase.Free;
end;

procedure TRALDBCrudModule.Reply(ARequest: TRALRequest; AResponse: TRALResponse);
var
  vResource: TRALDBCrudResource;
  vDB: TRALDBBase;
  vInfo: TRALDBTableInfo;
  vDialect: TRALDBDialect;
  vTenant, vKeyText, vWhere, vSQL, vCols, vSet, vValues, vETag, vMatch: StringRAL;
  vKeys, vKeyValues, vQueryParams: TStringList;
  vParams: TParams;
  vQuery: TDataSet;
  vQuerySpec: TRALDBQuery;
  vList: TRALJSONArray;
  vBody: TRALJSON;
  vValuesObj, vRecord: TRALJSONObject;
  vColumn: TRALDBColumnInfo;
  vInt, vCount: IntegerRAL;
  vLimit: Int64RAL;
  vRows, vLastId: Int64RAL;
  vMethod: TRALMethod;
  vHasKey, vAllow, vForce: Boolean;
  vOp: TRALDBCrudOperation;
  vStream: TStream;
  vParam: TRALParam;
  vSyntax: TRALDBFilterSyntax;

  /// Adds the conditions of the resource that never come from the URL.
  procedure AddFixedWhere(var AWhere: StringRAL);
  var
    vParamT: TParam;
  begin
    if vResource.BaseFilter <> '' then
    begin
      if AWhere <> '' then
        AWhere := AWhere + ' and ';
      AWhere := AWhere + '(' + vResource.BaseFilter + ')';
    end;
    if (FTenantMode = tmColumn) and (vResource.TenantField <> '') then
    begin
      if AWhere <> '' then
        AWhere := AWhere + ' and ';
      AWhere := AWhere + vDialect.Quote(vResource.TenantField) + ' = :ral_tenant';
      vParamT := vParams.CreateParam(ftString, 'ral_tenant', ptInput);
      RALDBSetParamValue(vParamT, vInfo.FindColumn(vResource.TenantField), vTenant);
    end;
  end;

  /// The condition on the key of the URL, with its params.
  function KeyWhere: StringRAL;
  var
    vIdx: IntegerRAL;
    vKeyParam: TParam;
  begin
    Result := '';
    if vKeyValues.Count <> vKeys.Count then
      raise ERALDBFilterError.Create('The key does not match the resource');
    for vIdx := 0 to vKeys.Count - 1 do
    begin
      vColumn := vInfo.FindColumn(ToRAL(vKeys[vIdx]));
      if vColumn = nil then
        raise ERALDBFilterError.CreateFmt('Unknown key field %s', [vKeys[vIdx]]);
      if Result <> '' then
        Result := Result + ' and ';
      Result := Result + vDialect.Quote(vColumn.Name) + ' = :ral_k' + StringRAL(IntToStr(vIdx));
      vKeyParam := vParams.CreateParam(ftString, 'ral_k' + IntToStr(vIdx), ptInput);
      RALDBSetParamValue(vKeyParam, vColumn, ToRAL(vKeyValues[vIdx]));
    end;
  end;

  /// The quoted list of the readable columns, or of AWanted when not empty.
  function SelectList(AWanted: TStrings): StringRAL;
  var
    vIdx: IntegerRAL;
  begin
    Result := '';
    for vIdx := 0 to vInfo.ColumnCount - 1 do
      if vResource.CanRead(vInfo[vIdx].Name) and ((AWanted = nil) or (AWanted.Count = 0) or
        Listed(AWanted, vInfo[vIdx].Name)) then
      begin
        if Result <> '' then
          Result := Result + ', ';
        Result := Result + vDialect.Quote(vInfo[vIdx].Name);
      end;
    if Result = '' then
      raise ERALDBFilterError.Create('No field to answer');
  end;

  /// The source of the selects: the table or the select of the resource.
  function Source: StringRAL;
  begin
    if vResource.SelectSQL <> '' then
      Result := '(' + vResource.SelectSQL + ') ral_q'
    else
      Result := vResource.TableName;
  end;

  /// Reads the record of the key; nil when there is none.
  function ReadRecord: TRALJSONObject;
  var
    vReadWhere: StringRAL;
  begin
    Result := nil;
    vParams.Clear;
    vReadWhere := KeyWhere;
    AddFixedWhere(vReadWhere);
    vQuery := vDB.OpenCompatible('select ' + SelectList(nil) + ' from ' + Source + ' where ' +
      vReadWhere, vParams);
    try
      if not vQuery.EOF then
        Result := RecordJSON(vQuery);
    finally
      vQuery.Free;
    end;
  end;

  /// The ETag of ARecord, from VersionField; '' when there is none.
  function ETagOf(ARecord: TRALJSONObject): StringRAL;
  var
    vVersion: TRALJSON;
    vIdx: IntegerRAL;
  begin
    Result := '';
    if (vResource.VersionField = '') or (ARecord = nil) then
      Exit;
    vVersion := nil;
    for vIdx := 0 to ARecord.Count - 1 do
      if RALSameName(ARecord.Names[vIdx], vResource.VersionField) then
        vVersion := ARecord.Items[vIdx];
    if vVersion <> nil then
      Result := '"' + vVersion.AsString + '"';
  end;

  /// The key text of ARecord, for the Location of an insert.
  function KeyTextOf(ARecord: TRALJSONObject): StringRAL;
  var
    vIdx, vName: IntegerRAL;
  begin
    Result := '';
    for vIdx := 0 to vKeys.Count - 1 do
    begin
      if vIdx > 0 then
        Result := Result + ',';
      for vName := 0 to ARecord.Count - 1 do
        if RALSameName(ARecord.Names[vName], ToRAL(vKeys[vIdx])) then
          Result := Result + ARecord.Items[vName].AsString;
    end;
  end;

  /// Answers ARecord (owned) with AStatus, its ETag, as JSON or the storage.
  procedure AnswerRecord(ARecord: TRALJSONObject; AStatus: IntegerRAL);
  begin
    try
      vETag := ETagOf(ARecord);
      if vETag <> '' then
        AResponse.AddHeader('ETag', vETag);
      AResponse.Answer(AStatus, ARecord.ToJSON, rctAPPLICATIONJSON);
    finally
      ARecord.Free;
    end;
  end;

  /// Whether If-Match of the request accepts the current ARecord.
  function MatchOK(ARecord: TRALJSONObject): Boolean;
  begin
    vMatch := ARequest.GetHeader('If-Match');
    Result := (vMatch = '') or (vMatch = '*') or (vResource.VersionField = '') or
      (vMatch = ETagOf(ARecord));
  end;

  /// Whether the identity may do AOp on the resource.
  function Allowed(AOp: TRALDBCrudOperation): Boolean;
  var
    vRoles: StringRAL;
  begin
    if AOp in [roList, roGet] then
      vRoles := vResource.ReadRoles
    else
      vRoles := vResource.WriteRoles;
    if vRoles = '' then
      vRoles := vResource.Roles;
    Result := (vRoles = '') or ARequest.Identity.HasRoles(vRoles, False);
  end;

begin
  vResource := TRALDBCrudRoute(ARequest.Route).Resource;
  if (FDBModule = nil) or (vResource = nil) then
  begin
    AnswerProblem(AResponse, HTTP_InternalError, 'TRALDBCrudModule.DBModule is not set');
    Exit;
  end;
  vMethod := ARequest.Method;
  vKeyText := '';
  vParam := ARequest.Params.Get[cKeyParam];
  if vParam <> nil then
    vKeyText := vParam.AsString;
  vHasKey := vKeyText <> '';
  if vHasKey then
    case vMethod of
      amGET: vOp := roGet;
      amPUT: vOp := roUpdate;
      amPATCH: vOp := roPatch;
    else
      vOp := roDelete;
    end
  else if vMethod = amPOST then
    vOp := roInsert
  else
    vOp := roList;
  if not (vOp in vResource.Operations) then
  begin
    AnswerProblem(AResponse, HTTP_MethodNotAllowed, 'Operation not allowed');
    Exit;
  end;
  if not Allowed(vOp) or ((vOp in [roInsert, roUpdate, roPatch, roDelete]) and
    (vResource.SelectSQL <> '')) then
  begin
    AnswerProblem(AResponse, HTTP_Forbidden, 'Forbidden');
    Exit;
  end;
  vTenant := TenantOf(ARequest);
  if (FTenantMode <> tmNone) and (vTenant = '') then
  begin
    AnswerProblem(AResponse, HTTP_Forbidden, 'No tenant');
    Exit;
  end;

  vParams := TParams.Create;
  vKeys := nil;
  vKeyValues := TStringList.Create;
  vBody := nil;
  vDB := AcquireFor(ARequest, AResponse, vTenant);
  try
    try
      vDialect := RALDBDialect(vDB.DatabaseType);
      vInfo := InfoOf(vResource, vDB);
      vKeys := KeyColumns(vResource, vInfo);
      vKeyValues.StrictDelimiter := True;
      vKeyValues.Delimiter := ',';
      vKeyValues.DelimitedText := FromRAL(vKeyText);

      if vOp = roList then
      begin
        vQuerySpec := TRALDBQuery.Create;
        vQueryParams := TStringList.Create;
        try
          for vInt := 0 to ARequest.Params.Count(rpkQUERY) - 1 do
          begin
            vParam := ARequest.Params.IndexKind[vInt, rpkQUERY];
            vQueryParams.Add(FromRAL(vParam.ParamName) + '=' + FromRAL(vParam.AsString));
          end;
          // D2: the syntax a request names wins: filter-syntax, then the header.
          vForce := False;
          vSyntax := fsSimple;
          vSet := ToRAL(vQueryParams.Values['filter-syntax']);
          if vSet = '' then
            vSet := ARequest.GetHeader('X-RAL-Filter-Syntax');
          if vSet <> '' then
          begin
            vForce := True;
            if RALSameName(vSet, 'rql') then
              vSyntax := fsRQL;
          end;
          vQuerySpec.Parse(vQueryParams, FFilterSyntaxes, vForce, vSyntax);
          if vQuerySpec.Sort.Count = 0 then
            vQuerySpec.Sort.CommaText := FromRAL(vResource.DefaultSort);
          vWhere := vQuerySpec.WhereSQL(vInfo, vDialect, vParams);
          AddFixedWhere(vWhere);
          vSQL := ' from ' + Source;
          if vWhere <> '' then
            vSQL := vSQL + ' where ' + vWhere;
          if FTotalCount then
          begin
            vQuery := vDB.OpenCompatible('select count(*) as ral_total' + vSQL, vParams);
            try
              AResponse.AddHeader('X-Total-Count', ToRAL(vQuery.Fields[0].AsString));
            finally
              vQuery.Free;
            end;
          end;
          vSQL := 'select ' + SelectList(vQuerySpec.Fields) + vSQL;
          vCols := vQuerySpec.OrderSQL(vInfo, vDialect);
          if vCols <> '' then
            vSQL := vSQL + ' order by ' + vCols;
          vLimit := vQuerySpec.Limit;
          if (vLimit <= 0) or (vLimit > vResource.MaxPageSize) then
            vLimit := vResource.MaxPageSize;
          vSQL := vDialect.Page(vSQL, vLimit, vQuerySpec.Offset);
          vQuery := vDB.OpenCompatible(vSQL, vParams);
          try
            if (FStorage <> nil) and (Pos(FromRAL(FStorage.ContentType),
              FromRAL(ARequest.GetHeader('Accept'))) > 0) then
            begin
              vStream := TMemoryStream.Create;
              try
                FStorage.SaveToStream(vQuery, vStream);
                vStream.Position := 0;
              except
                vStream.Free;
                raise;
              end;
              AResponse.Answer(HTTP_OK, vStream, FStorage.ContentType, True);
            end
            else
            begin
              vList := TRALJSONArray.Create;
              try
                while not vQuery.EOF do
                begin
                  vList.Add(RecordJSON(vQuery));
                  vQuery.Next;
                end;
                AResponse.Answer(HTTP_OK, vList.ToJSON, rctAPPLICATIONJSON);
              finally
                vList.Free;
              end;
            end;
          finally
            vQuery.Free;
          end;
        finally
          vQueryParams.Free;
          vQuerySpec.Free;
        end;
        Exit;
      end;

      if vOp = roGet then
      begin
        vRecord := ReadRecord;
        if vRecord = nil then
          AnswerProblem(AResponse, HTTP_NotFound, 'Not found')
        else
          AnswerRecord(vRecord, HTTP_OK);
        Exit;
      end;

      if vOp in [roInsert, roUpdate, roPatch] then
      begin
        try
          vBody := TRALJSON.ParseJSON(ARequest.RequestText);
        except
          raise ERALDBFilterError.Create('The body is not valid JSON');
        end;
        if vBody.Kind <> rjkObject then
          raise ERALDBFilterError.Create('The body must be a JSON object');
        // Only columns of the catalog the resource lets write go to the SQL.
        vValuesObj := TRALJSONObject.Create;
        try
          for vInt := 0 to TRALJSONObject(vBody).Count - 1 do
          begin
            vColumn := vInfo.FindColumn(TRALJSONObject(vBody).Names[vInt]);
            if vColumn = nil then
              raise ERALDBFilterError.CreateFmt('Unknown field %s',
                [FromRAL(TRALJSONObject(vBody).Names[vInt])]);
            if not vResource.CanWrite(vColumn) then
            begin
              if (vOp = roInsert) or not vColumn.IsKey then
                raise ERALDBFilterError.CreateFmt('Field %s cannot be written', [FromRAL(vColumn.Name)]);
              Continue;
            end;
            if vColumn.IsKey and (vOp <> roInsert) then
              Continue;
            vValuesObj.Add(vColumn.Name, TRALJSON.ParseJSON(TRALJSONObject(vBody).Items[vInt].ToJSON));
          end;
          if vOp = roUpdate then
            // PUT replaces: the writable columns not sent become null.
            for vInt := 0 to vInfo.ColumnCount - 1 do
              if vResource.CanWrite(vInfo[vInt]) and not vInfo[vInt].IsKey and
                (vValuesObj.Find(vInfo[vInt].Name) = nil) then
                vValuesObj.Add(vInfo[vInt].Name, TRALJSONNull.Create);

          vAllow := True;
          if (vOp = roInsert) and Assigned(vResource.OnBeforeInsert) then
            vResource.OnBeforeInsert(Self, ARequest, vResource, vValuesObj, vAllow)
          else if (vOp <> roInsert) and Assigned(vResource.OnBeforeUpdate) then
            vResource.OnBeforeUpdate(Self, ARequest, vResource, vValuesObj, vAllow);
          if not vAllow then
          begin
            AnswerProblem(AResponse, HTTP_Forbidden, 'Refused');
            Exit;
          end;

          if vOp = roInsert then
          begin
            // A key sent that exists already is a conflict.
            vCount := 0;
            vKeyValues.Clear;
            for vInt := 0 to vKeys.Count - 1 do
              if vValuesObj.Find(ToRAL(vKeys[vInt])) <> nil then
              begin
                vKeyValues.Add(FromRAL(vValuesObj.Find(ToRAL(vKeys[vInt])).AsString));
                Inc(vCount);
              end;
            if (vCount = vKeys.Count) and (vCount > 0) then
            begin
              vRecord := ReadRecord;
              if vRecord <> nil then
              begin
                vRecord.Free;
                AnswerProblem(AResponse, cHTTPConflict, 'The key exists');
                Exit;
              end;
            end;
            vParams.Clear;
            vCols := '';
            vValues := '';
            for vInt := 0 to vValuesObj.Count - 1 do
            begin
              vColumn := vInfo.FindColumn(vValuesObj.Names[vInt]);
              if vCols <> '' then
              begin
                vCols := vCols + ', ';
                vValues := vValues + ', ';
              end;
              vCols := vCols + vDialect.Quote(vColumn.Name);
              vValues := vValues + ':v' + StringRAL(IntToStr(vInt));
              SetParamJSON(vParams.CreateParam(ftString, 'v' + IntToStr(vInt), ptInput), vColumn,
                vValuesObj.Items[vInt]);
            end;
            if vResource.VersionField <> '' then
            begin
              if vCols <> '' then
              begin
                vCols := vCols + ', ';
                vValues := vValues + ', ';
              end;
              vCols := vCols + vDialect.Quote(vResource.VersionField);
              vValues := vValues + '1';
            end;
            if (FTenantMode = tmColumn) and (vResource.TenantField <> '') then
            begin
              if vCols <> '' then
              begin
                vCols := vCols + ', ';
                vValues := vValues + ', ';
              end;
              vCols := vCols + vDialect.Quote(vResource.TenantField);
              vValues := vValues + ':ral_tenantv';
              RALDBSetParamValue(vParams.CreateParam(ftString, 'ral_tenantv', ptInput),
                vInfo.FindColumn(vResource.TenantField), vTenant);
            end;
            vRows := 0;
            vLastId := 0;
            vSQL := 'insert into ' + vResource.TableName + ' (' + vCols + ') values (' +
              vValues + ')';
            if (vCount < vKeys.Count) and (vKeys.Count = 1) and
              (vDialect.LastInsertIdSQL = '') then
            begin
              // Firebird gives the generated key through RETURNING.
              vQuery := vDB.OpenCompatible(vSQL + ' returning ' +
                vDialect.Quote(ToRAL(vKeys[0])), vParams);
              try
                vLastId := vQuery.Fields[0].AsLargeInt;
              finally
                vQuery.Free;
              end;
            end
            else
              vDB.ExecSQL(vSQL, vParams, vRows, vLastId);
            if vCount < vKeys.Count then
            begin
              // The generated key: what the insert of this connection made.
              if (vLastId = 0) and (vDialect.LastInsertIdSQL <> '') then
              begin
                vQuery := vDB.OpenCompatible(vDialect.LastInsertIdSQL, nil);
                try
                  vLastId := vQuery.Fields[0].AsLargeInt;
                finally
                  vQuery.Free;
                end;
              end;
              vKeyValues.Clear;
              vKeyValues.Add(IntToStr(vLastId));
            end;
            vRecord := ReadRecord;
            if vRecord = nil then
            begin
              AResponse.Answer(HTTP_Created, '', rctAPPLICATIONJSON);
              Exit;
            end;
            AResponse.AddHeader('Location', ARequest.Query + '/' + KeyTextOf(vRecord));
            if Assigned(vResource.OnAfterWrite) then
              vResource.OnAfterWrite(Self, ARequest, vResource, vRecord);
            AnswerRecord(vRecord, HTTP_Created);
            Exit;
          end;

          // update and patch
          vRecord := ReadRecord;
          if vRecord = nil then
          begin
            AnswerProblem(AResponse, HTTP_NotFound, 'Not found');
            Exit;
          end;
          try
            if not MatchOK(vRecord) then
            begin
              AnswerProblem(AResponse, cHTTPPreconditionFailed, 'The record changed');
              Exit;
            end;
            vETag := ETagOf(vRecord);
          finally
            vRecord.Free;
          end;
          vParams.Clear;
          vSet := '';
          for vInt := 0 to vValuesObj.Count - 1 do
          begin
            vColumn := vInfo.FindColumn(vValuesObj.Names[vInt]);
            if vSet <> '' then
              vSet := vSet + ', ';
            vSet := vSet + vDialect.Quote(vColumn.Name) + ' = :v' + StringRAL(IntToStr(vInt));
            SetParamJSON(vParams.CreateParam(ftString, 'v' + IntToStr(vInt), ptInput), vColumn,
              vValuesObj.Items[vInt]);
          end;
          if vResource.VersionField <> '' then
          begin
            if vSet <> '' then
              vSet := vSet + ', ';
            vSet := vSet + vDialect.Quote(vResource.VersionField) + ' = ' +
              vDialect.Quote(vResource.VersionField) + ' + 1';
          end;
          if vSet = '' then
            raise ERALDBFilterError.Create('Nothing to write');
          vWhere := KeyWhere;
          AddFixedWhere(vWhere);
          if (vResource.VersionField <> '') and (vETag <> '') then
          begin
            vWhere := vWhere + ' and ' + vDialect.Quote(vResource.VersionField) + ' = :ral_version';
            RALDBSetParamValue(vParams.CreateParam(ftString, 'ral_version', ptInput),
              vInfo.FindColumn(vResource.VersionField), Copy(vETag, 2, Length(vETag) - 2));
          end;
          vRows := 0;
          vLastId := 0;
          vDB.ExecSQL('update ' + vResource.TableName + ' set ' + vSet + ' where ' + vWhere,
            vParams, vRows, vLastId);
          if vRows = 0 then
          begin
            AnswerProblem(AResponse, cHTTPPreconditionFailed, 'The record changed');
            Exit;
          end;
          vRecord := ReadRecord;
          if Assigned(vResource.OnAfterWrite) then
            vResource.OnAfterWrite(Self, ARequest, vResource, vRecord);
          AnswerRecord(vRecord, HTTP_OK);
        finally
          vValuesObj.Free;
        end;
        Exit;
      end;

      // delete
      vRecord := ReadRecord;
      if vRecord = nil then
      begin
        AnswerProblem(AResponse, HTTP_NotFound, 'Not found');
        Exit;
      end;
      try
        if not MatchOK(vRecord) then
        begin
          AnswerProblem(AResponse, cHTTPPreconditionFailed, 'The record changed');
          Exit;
        end;
        vAllow := True;
        if Assigned(vResource.OnBeforeDelete) then
          vResource.OnBeforeDelete(Self, ARequest, vResource, vRecord, vAllow);
        if not vAllow then
        begin
          AnswerProblem(AResponse, HTTP_Forbidden, 'Refused');
          Exit;
        end;
      finally
        vRecord.Free;
      end;
      vParams.Clear;
      vWhere := KeyWhere;
      AddFixedWhere(vWhere);
      vRows := 0;
      vLastId := 0;
      vDB.ExecSQL('delete from ' + vResource.TableName + ' where ' + vWhere, vParams, vRows, vLastId);
      if Assigned(vResource.OnAfterWrite) then
        vResource.OnAfterWrite(Self, ARequest, vResource, nil);
      AResponse.Answer(HTTP_NoContent, '', rctAPPLICATIONJSON);
    except
      on E: ERALDBFilterError do
        AnswerProblem(AResponse, HTTP_BadRequest, ToRAL(E.Message));
      on E: Exception do
        // A unique or key constraint the database refused is a conflict.
        if (Pos('unique', LowerCase(E.Message)) > 0) or (Pos('duplicate', LowerCase(E.Message)) > 0) or
          (Pos('primary key', LowerCase(E.Message)) > 0) then
          AnswerProblem(AResponse, cHTTPConflict, 'The record conflicts with another')
        else
          raise;
    end;
  finally
    ReleaseFor(vDB, vTenant);
    vBody.Free;
    vKeys.Free;
    vKeyValues.Free;
    vParams.Free;
  end;
end;

class function TRALDBCrudModule.RouteClass: TRALRouteClass;
begin
  Result := TRALDBCrudRoute;
end;

procedure TRALDBCrudModule.ServerActivating;
begin
  inherited ServerActivating;
  RefreshRoutes;
end;

procedure TRALDBCrudModule.SetDBModule(AValue: TRALDBModule);
begin
  if FDBModule = AValue then
    Exit;
  if FDBModule <> nil then
    FDBModule.RemoveFreeNotification(Self);
  FDBModule := AValue;
  if FDBModule <> nil then
    FDBModule.FreeNotification(Self);
end;

procedure TRALDBCrudModule.SetResources(AValue: TRALDBCrudResources);
begin
  FResources.Assign(AValue);
end;

procedure TRALDBCrudModule.SetStorage(AValue: TRALStorageLink);
begin
  if FStorage = AValue then
    Exit;
  if FStorage <> nil then
    FStorage.RemoveFreeNotification(Self);
  FStorage := AValue;
  if FStorage <> nil then
    FStorage.FreeNotification(Self);
end;

function TRALDBCrudModule.TenantOf(ARequest: TRALRequest): StringRAL;
begin
  Result := '';
  if FTenantMode = tmNone then
    Exit;
  Result := ARequest.Identity.Claim(FTenantClaim);
  if (Result = '') and (FTenantHeader <> '') then
    Result := ARequest.GetHeader(FTenantHeader);
  if Assigned(FOnGetTenant) then
    FOnGetTenant(Self, ARequest, Result);
end;

end.
