        <Resource_5 FileName="api/api-dev.json" Type="RCDATA" ResourceName="API_DEV"/>
        <Resource_6 FileName="api/api-2.0.json" Type="RCDATA" ResourceName="API_2_0"/>
        <Resource_7 FileName="languages/ralmigrador.pt-BR.po" Type="RCDATA" ResourceName="PO_PT_BR"/>
        <Resource_8 FileName="languages/ralmigrador.en-US.po" Type="RCDATA" ResourceName="PO_EN_US"/>
        <Resource_9 FileName="languages/ralmigrador.es-ES.po" Type="RCDATA" ResourceName="PO_ES_ES"/>
      </Resources>
    </General>
    <VersionInfo>
