msgstr "%d proyecto(s) compilado(s), %d con errores."

#: ralmig.acoes.projeto.emacaofalha
msgid "Regra %s, arquivo %s: %s"
msgstr "Regla %s, archivo %s: %s"

#: ralmig.acoes.projeto.cmacaopacotetrocado
msgid "Pacote %s trocado por %s"
msgstr "Paquete %s reemplazado por %s"

#: ralmig.acoes.projeto.cmacaopacoteacrescentado
msgid "Pacote %s acrescentado (o projeto usa %s)"
msgstr "Paquete %s agregado (el proyecto usa %s)"

#: ralmig.acoes.projeto.cmacaocaminhotrocado
