msgid "Cópia de segurança: %s"
msgstr "Copia de seguridad: %s"

#: ralmig.console.mensagens.emclisemcopia
msgid "Não há cópia de segurança em %s: não há como desfazer."
msgstr "No hay copia de seguridad en %s: no hay manera de deshacer."

#: ralmig.console.mensagens.wmclirelatoriomantido
msgid "Relatório alterado depois da migração, mantido: %s"
msgstr "Informe modificado después de la migración, conservado: %s"

#: ralmig.console.mensagens.cmclidesfeito
