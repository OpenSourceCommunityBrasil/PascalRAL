msgstr "Unit %s reemplazada por %s en el uses (%d vez/veces)"

#: ralmig.acoes.projeto.cmacaounitacrescentada
msgid "Unit %s acrescentada ao uses (o código usa %s)"
msgstr "Unit %s agregada al uses (el código usa %s)"

#: ralmig.acoes.projeto.cmacaodesignpararuntime
msgid "Pacote %s trocado por %s (o pacote não registra componentes)"
msgstr "Paquete %s reemplazado por %s (el paquete no registra componentes)"

#: ralmig.acoes.formulario.serroform
msgid "Formulário %s não pôde ser lido (linha %d): %s"
msgstr "No se pudo leer el formulario %s (línea %d): %s"

#: ralmig.acoes.formulario.sfeitocriado
msgid "Criado %s (%s) ligado a %s"
msgstr "Creado %s (%s) vinculado a %s"

#: ralmig.acoes.formulario.sfeitoremovidas
msgid "%s: removidas %s"
msgstr "%s: quitadas %s"

#: ralmig.acoes.formulario.sfeitorenomeada
msgid "%s: propriedade %s renomeada para %s"
msgstr "%s: propiedad %s renombrada a %s"

#: ralmig.acoes.formulario.sfeitomaterializada
msgid "%s: %s = %s escrito explicitamente"
msgstr "%s: %s = %s escrito explícitamente"

#: ralmig.acoes.formulario.sfeitocampo
msgid "Campo %s: %s acrescentado à classe do formulário"
msgstr "Campo %s: %s agregado a la clase del formulario"

#: ralmig.acoes.formulario.sfeitouses
msgid "Unit %s acrescentada ao uses"
msgstr "Unit %s agregada al uses"

#: ralmig.acoes.formulario.sprobdestinoexiste
msgid "A propriedade %s já existe em %s: não foi renomeada."
msgstr "La propiedad %s ya existe en %s: no se renombró."

#: ralmig.acoes.formulario.sprobdescartavel
msgid "A propriedade %s de %s tem o valor %s, que não é o padrão: não foi removida."
msgstr "La propiedad %s de %s tiene el valor %s, que no es el predeterminado: no se quitó."

#: ralmig.acoes.formulario.sprobsemancestral
msgid "O formulário ancestral de %s não está no conjunto: a propriedade não foi tocada."
msgstr "El formulario ancestro de %s no está en el conjunto: no se tocó la propiedad."

#: ralmig.acoes.formulario.sprobvalordiferente
msgid "Em %s a propriedade %s (%s) difere da do formulário ancestral e foi removida."
msgstr "En %s la propiedad %s (%s) difiere de la del formulario ancestro y se quitó."

#: ralmig.acoes.formulario.sprobpluginexiste
msgid "O servidor %s já tem um plugin %s e ainda tem propriedades antigas: nada foi movido."
msgstr "El servidor %s ya tiene un plugin %s y todavía tiene propiedades antiguas: no se movió nada."

#: ralmig.acoes.formulario.sprobclassenaoprovada
msgid "Não foi possível provar que a classe %s de %s descende de um servidor RAL."
msgstr "No fue posible probar que la clase %s de %s desciende de un servidor RAL."

#: ralmig.acoes.formulario.sprobansi
msgid "O valor de %s tem caracteres fora do ASCII num arquivo ANSI: o plugin não foi criado."
msgstr "El valor de %s tiene caracteres fuera de ASCII en un archivo ANSI: no se creó el plugin."

#: ralmig.acoes.formulario.sprobsemclasse
msgid "A classe %s não foi achada na unit do formulário: acrescente o campo à mão."
msgstr "No se encontró la clase %s en la unit del formulario: agregue el campo a mano."

#: ralmig.acoes.formulario.sprobsemunit
msgid "O formulário %s não tem a unit par no conjunto: acrescente o campo e a unit à mão."
msgstr "El formulario %s no tiene la unit par en el conjunto: agregue el campo y la unit a mano."

#: ralmig.acoes.codigo.rscodrenomeado
msgid "%de% is now %para%."
msgstr "%de% ahora es %para%."

#: ralmig.acoes.codigo.rscodclasseform
msgid "The class of %nome% changed from %de% to %para%."
msgstr "La clase de %nome% cambió de %de% a %para%."

#: ralmig.acoes.codigo.rscodmovido
msgid "%de% is now %para%."
msgstr "%de% ahora es %para%."

#: ralmig.acoes.codigo.rscodremovido
msgid "%nome% no longer exists on the server; the line was removed."
msgstr "%nome% ya no existe en el servidor; se quitó la línea."

#: ralmig.acoes.codigo.rscodfazerplugin
msgid "In %arquivo%, line %linha%: %variavel% no longer has these properties; create %componente% (unit %unit%) next to where the server is created, set its Server to %variavel% and move the values to it, then delete the old lines."
msgstr "En %arquivo%, línea %linha%: %variavel% ya no tiene estas propiedades; cree %componente% (unit %unit%) junto a donde se crea el servidor, ponga su Server en %variavel%, mueva los valores a él y borre las líneas antiguas."

#: ralmig.acoes.codigo.rscodfazerremover
msgid "In %arquivo%, line %linha%: %nome% no longer exists on the server; delete this use."
msgstr "En %arquivo%, línea %linha%: %nome% ya no existe en el servidor; borre este uso."

#: ralmig.acoes.codigo.rscodfazerrenomear
msgid "In %arquivo%, line %linha%: rename %de% to %para% if %variavel% is a %classe%."
msgstr "En %arquivo%, línea %linha%: renombre %de% a %para% si %variavel% es un %classe%."

#: ralmig.acoes.codigo.rscodsemtexto
msgid "See the migration notes of the RAL."
msgstr "Vea las notas de migración de RAL."

#: ralmig.acoes.codigo.rscodsomenterelatorio
msgid "See the report."
msgstr "Vea el informe."

