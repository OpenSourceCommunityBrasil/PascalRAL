msgid "Nada foi alterado; o relatório da migração anterior foi mantido: %s"
msgstr "No se cambió nada; se conservó el informe de la migración anterior: %s"

#: ralmig.console.mensagens.wmclirelatoriosemregistro
msgid "O relatório não foi registrado na cópia de segurança (o desfazer não o removerá): %s"
msgstr "El informe no se registró en la copia de seguridad (deshacer no lo quitará): %s"

