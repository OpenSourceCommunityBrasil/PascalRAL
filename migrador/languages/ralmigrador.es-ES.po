msgid "[%s] %d diferenças, %d pendentes"
msgstr "[%s] %d diferencias, %d pendientes"

#: ralmig.console.mensagens.emcliconferirsemral
msgid "Com --ide informe também --ral=<raiz do RAL de destino>."
msgstr "Con --ide indique también --ral=<raíz del RAL de destino>."

#: ralmig.console.mensagens.emcliconferirideinvalida
msgid "Não é uma IDE, ou o RAL informado não tem a pasta src: %s"
msgstr "No es un IDE, o el RAL indicado no tiene la carpeta src: %s"

#: ralmig.console.mensagens.emcliconferirsemide
msgid "Nenhuma IDE com o RAL %s nos recibos do instalador; informe --ide=<raiz da IDE> e --ral=<raiz do RAL>."
msgstr "Ningún IDE con el RAL %s en los recibos del instalador; indique --ide=<raíz del IDE> y --ral=<raíz de RAL>."

#: ralmig.console.mensagens.emcliconferirsemprojeto
