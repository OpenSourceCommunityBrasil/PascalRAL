msgstr "With --ide also give --ral=<target RAL root>."

#: ralmig.console.mensagens.emcliconferirideinvalida
msgid "Não é uma IDE, ou o RAL informado não tem a pasta src: %s"
msgstr "Not an IDE, or the given RAL has no src folder: %s"

