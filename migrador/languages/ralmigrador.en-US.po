msgid "Nenhuma IDE com o RAL %s nos recibos do instalador; informe --ide=<raiz da IDE> e --ral=<raiz do RAL>."
msgstr "No IDE with RAL %s in the installer receipts; give --ide=<IDE root> and --ral=<RAL root>."

