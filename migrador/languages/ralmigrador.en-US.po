#: ralmig.console.mensagens.emcliuso
msgid "Uso: ralmigra detectar|previa|aplicar|desfazer|conferir|inventario <pasta> [opções]. Use ralmigra --ajuda para ver tudo."
msgstr "Usage: ralmigra detectar|previa|aplicar|desfazer|conferir|inventario <folder> [options]. Use ralmigra --ajuda to see everything."

#: ralmig.console.mensagens.emcliverbodesconhecido
msgid "Comando desconhecido: %s"
msgstr "Unknown command: %s"

#: ralmig.console.mensagens.emclisempasta
msgid "Informe a pasta do projeto."
msgstr "Enter the project folder."

#: ralmig.console.mensagens.cmajudatitulo
msgid "ralmigra: migra projetos Delphi e Lazarus entre versões do PascalRAL."
msgstr "ralmigra: migrates Delphi and Lazarus projects between PascalRAL versions."

#: ralmig.console.mensagens.cmajudacomandos
msgid "Comandos:"
msgstr "Commands:"

#: ralmig.console.mensagens.cmajudadetectar
msgid "  detectar <pasta>    mostra a versão do RAL que o projeto usa e as pistas"
msgstr "  detectar <folder>    shows the RAL version the project uses and the clues"

#: ralmig.console.mensagens.cmajudaprevia
msgid "  previa <pasta>      mostra o que mudaria e o relatório, sem gravar nada"
msgstr "  previa <folder>      shows what would change and the report, writing nothing"

#: ralmig.console.mensagens.cmajudaaplicar
msgid "  aplicar <pasta>     grava a migração e o relatório (MIGRACAO-RAL-<de>-<para>.md e .html)"
msgstr "  aplicar <folder>     writes the migration and the report (MIGRACAO-RAL-<from>-<to>.md and .html)"

#: ralmig.console.mensagens.cmajudadesfazer
msgid "  desfazer <pasta>    volta ao que havia antes, pela cópia de segurança"
msgstr "  desfazer <folder>    goes back to what there was before, using the backup"

#: ralmig.console.mensagens.cmajudaconferir
msgid "  conferir <pasta>    compila o projeto migrado contra o RAL de destino"
msgstr "  conferir <folder>    compiles the migrated project against the target RAL"

#: ralmig.console.mensagens.cmajudainventario
msgid "  inventario          confere a cobertura das regras com a API de cada versão"
msgstr "  inventario          checks the coverage of the rules against the API of each version"

#: ralmig.console.mensagens.cmajudaopcoes
msgid "Opções:"
msgstr "Options:"

#: ralmig.console.mensagens.cmajudade
msgid "  --de=<versão>       versão de origem (sem ela, é detectada)"
msgstr "  --de=<version>       source version (without it, it is detected)"

#: ralmig.console.mensagens.cmajudapara
msgid "  --para=<versão>     versão de destino (sem ela, a mais nova)"
msgstr "  --para=<version>     target version (without it, the newest)"

#: ralmig.console.mensagens.cmajudaidioma
msgid "  --idioma=<idioma>   pt-BR, en-US ou es-ES (sem ele, o do sistema)"
msgstr "  --idioma=<language>  pt-BR, en-US or es-ES (without it, the system one)"

#: ralmig.console.mensagens.cmajudabackup
msgid "  --backup            aplicar: faz a cópia de segurança em _ral-migracao (sem ela não há desfazer)"
msgstr "  --backup            aplicar: makes the backup in _ral-migracao (without it there is no undo)"

#: ralmig.console.mensagens.cmajudaconverter
msgid "  --converter-binarios  converte formulários binários para texto em vez de deixá-los de fora"
msgstr "  --converter-binarios  converts binary forms to text instead of leaving them out"

#: ralmig.console.mensagens.cmajudaforcar
msgid "  --forcar-de         aplica os passos desde --de mesmo se o projeto já estiver mais novo"
msgstr "  --forcar-de         applies the steps from --de even if the project is already newer"

#: ralmig.console.mensagens.cmajudaignorarerros
msgid "  --ignorar-erros     aplicar: grava mesmo se a migração teve erros"
msgstr "  --ignorar-erros     aplicar: writes even if the migration had errors"

#: ralmig.console.mensagens.cmajudazip
msgid "  --zip=<cópia>       desfazer: a cópia a restaurar (sem ela, a mais recente)"
msgstr "  --zip=<backup>      desfazer: the backup to restore (without it, the most recent)"

#: ralmig.console.mensagens.cmajudaide
msgid "  --ide=<raiz da IDE> conferir: a IDE que compila (sem ela, as dos recibos do instalador)"
msgstr "  --ide=<IDE root>    conferir: the IDE that compiles (without it, the ones in the installer receipts)"

#: ralmig.console.mensagens.cmajudaral
msgid "  --ral=<raiz do RAL> conferir: os fontes do RAL de destino (com --ide); nos outros comandos, lê o ralmigracao.json dele (--raiz-ral)"
msgstr "  --ral=<RAL root>    conferir: the sources of the target RAL (with --ide); in the other commands, reads its ralmigracao.json (--raiz-ral)"

#: ralmig.console.mensagens.cmajudasaida
msgid "Código de saída: 0 nada a fazer à mão, 1 sobrou item manual, 2 erro, 3 recusado (o destino é mais velho que a origem)."
msgstr "Exit code: 0 nothing to do by hand, 1 a manual item is left, 2 error, 3 refused (the target is older than the source)."

#: ralmig.console.mensagens.cmcliconfalta
msgid "alta"
msgstr "high"

#: ralmig.console.mensagens.cmcliconfmedia
msgid "média"
msgstr "medium"

#: ralmig.console.mensagens.cmcliconfbaixa
msgid "baixa"
