<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RALModuleChatMetaPackage"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\..\src\modules\chat\meta"/>
        <UnitOutputDirectory Value="..\..\..\compiled\lazarus\$(TargetCPU)-$(TargetOS)\ralmodulechatmetapackage"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Chat channels: Meta (WhatsApp Cloud API, Messenger, Instagram)"/>
    <Version Major="2"/>
    <Files Count="3">
      <Item1>
        <Filename Value="..\..\..\src\modules\chat\meta\RALChatGraph.pas"/>
        <UnitName Value="RALChatGraph"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\modules\chat\meta\RALChatWhatsApp.pas"/>
        <UnitName Value="RALChatWhatsApp"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\modules\chat\meta\RALChatMeta.pas"/>
        <UnitName Value="RALChatMeta"/>
      </Item3>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="3">
      <Item1>
        <PackageName Value="PascalRAL"/>
        <MinVersion Major="2" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="RALModuleChatPackage"/>
        <MinVersion Major="2" Valid="True"/>
      </Item2>
      <Item3>
        <PackageName Value="FCL"/>
      </Item3>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
