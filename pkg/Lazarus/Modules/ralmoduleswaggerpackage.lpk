<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RALModuleSwaggerPackage"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\..\src\modules\swagger"/>
        <UnitOutputDirectory Value="..\..\..\compiled\lazarus\$(TargetCPU)-$(TargetOS)\ralmoduleswaggerpackage"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Swagger module"/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\modules\swagger\RALSwaggerExporter.pas"/>
        <UnitName Value="RALSwaggerExporter"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\modules\swagger\RALPostmanExporter.pas"/>
        <UnitName Value="RALPostmanExporter"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\modules\swagger\RALSwaggerModule.pas"/>
        <UnitName Value="RALSwaggerModule"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\modules\swagger\RALModuleSwaggerReg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALModuleSwaggerReg"/>
      </Item4>
      <Item5>
        <Filename Value="ralmoduleswaggerpackage.lrs"/>
        <Type Value="LRS"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
