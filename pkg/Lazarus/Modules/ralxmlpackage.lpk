<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="ralxmlpackage"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\..\..\src\base;..\..\..\src\languages;."/>
        <OtherUnitFiles Value="..\..\..\src\modules\xml"/>
        <UnitOutputDirectory Value="..\..\..\compiled"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="XML library and XML dataset storage for PascalRAL."/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\modules\xml\RALXMLReader.pas"/>
        <UnitName Value="RALXMLReader"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\modules\xml\RALXMLWriter.pas"/>
        <UnitName Value="RALXMLWriter"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\modules\xml\RALXML.pas"/>
        <UnitName Value="RALXML"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\modules\xml\RALStorageXML.pas"/>
        <UnitName Value="RALStorageXML"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\modules\xml\RALXMLReg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALXMLReg"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="RALDBPackage"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
