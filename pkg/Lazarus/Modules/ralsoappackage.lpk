<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="ralsoappackage"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\..\..\src\base;..\..\..\src\languages;."/>
        <OtherUnitFiles Value="..\..\..\src\modules\soap"/>
        <UnitOutputDirectory Value="..\..\..\compiled"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="SOAP 1.1/1.2 module, WSDL exporter and SOAP client for PascalRAL."/>
    <Version Major="1" Minor="3"/>
    <Files Count="6">
      <Item1>
        <Filename Value="..\..\..\src\modules\soap\RALSOAPTypes.pas"/>
        <UnitName Value="RALSOAPTypes"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\modules\soap\RALSOAPModule.pas"/>
        <UnitName Value="RALSOAPModule"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\modules\soap\RALWSDLExporter.pas"/>
        <UnitName Value="RALWSDLExporter"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\modules\soap\RALSOAPClient.pas"/>
        <UnitName Value="RALSOAPClient"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\modules\soap\RALSOAPActions.pas"/>
        <UnitName Value="RALSOAPActions"/>
      </Item5>
      <Item6>
        <Filename Value="..\..\..\src\modules\soap\RALSOAPReg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALSOAPReg"/>
      </Item6>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="4">
      <Item1>
        <PackageName Value="ralxmlpackage"/>
      </Item1>
      <Item2>
        <PackageName Value="IDEIntf"/>
      </Item2>
      <Item3>
        <PackageName Value="LCL"/>
      </Item3>
      <Item4>
        <PackageName Value="FCL"/>
      </Item4>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
