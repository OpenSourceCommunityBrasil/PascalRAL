      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Dataset storage (BIN, JSON, CSV)"/>
    <Version Major="2"/>
    <Files Count="8">
      <Item1>
        <Filename Value="..\..\..\src\storage\RALStorageTypes.pas"/>
        <UnitName Value="RALStorageTypes"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\storage\RALDBTypes.pas"/>
        <UnitName Value="RALDBTypes"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\storage\RALStorage.pas"/>
        <UnitName Value="RALStorage"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\storage\RALStorageBIN.pas"/>
        <UnitName Value="RALStorageBIN"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\storage\RALStorageJSON.pas"/>
        <UnitName Value="RALStorageJSON"/>
      </Item5>
      <Item6>
        <Filename Value="..\..\..\src\storage\RALStorageCSV.pas"/>
        <UnitName Value="RALStorageCSV"/>
      </Item6>
      <Item7>
        <Filename Value="..\..\..\src\storage\RALStorageReg.pas"/>
