          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Network: sockets, TLS and DTLS, WebSocket, proxies"/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\net\RALSocket.pas"/>
        <UnitName Value="RALSocket"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\net\RALTLS.pas"/>
        <UnitName Value="RALTLS"/>
