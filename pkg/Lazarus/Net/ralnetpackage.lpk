        <Filename Value="..\..\..\src\net\RALSocketProxy.pas"/>
        <UnitName Value="RALSocketProxy"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\net\RALSocketLoop.pas"/>
        <UnitName Value="RALSocketLoop"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
