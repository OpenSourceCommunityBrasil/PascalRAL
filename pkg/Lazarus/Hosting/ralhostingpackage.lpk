      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Hosting: service and daemon, system log, configuration, scheduler"/>
    <Version Major="2"/>
    <Files Count="6">
      <Item1>
        <Filename Value="..\..\..\src\hosting\RALServiceHost.pas"/>
        <UnitName Value="RALServiceHost"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\hosting\RALSystemLog.pas"/>
        <UnitName Value="RALSystemLog"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\hosting\RALConfig.pas"/>
        <UnitName Value="RALConfig"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\hosting\RALScheduler.pas"/>
        <UnitName Value="RALScheduler"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\hosting\RALHostingReg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALHostingReg"/>
      </Item5>
      <Item6>
        <Filename Value="ralhostingpackage.lrs"/>
        <Type Value="LRS"/>
      </Item6>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="3">
