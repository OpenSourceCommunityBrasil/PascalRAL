<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RALCryptoPasswordPackage"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\..\src\crypto\password"/>
        <UnitOutputDirectory Value="..\..\..\compiled\lazarus\$(TargetCPU)-$(TargetOS)\ralcryptopasswordpackage"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Password hashing: Argon2id, bcrypt, scrypt, PBKDF2"/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\crypto\password\RALArgon2.pas"/>
        <UnitName Value="RALArgon2"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\crypto\password\RALScrypt.pas"/>
        <UnitName Value="RALScrypt"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\crypto\password\RALPassword.pas"/>
        <UnitName Value="RALPassword"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\crypto\password\RALCryptoPasswordReg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALCryptoPasswordReg"/>
      </Item4>
      <Item5>
        <Filename Value="ralcryptopasswordpackage.lrs"/>
        <Type Value="LRS"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="PascalRAL"/>
        <MinVersion Major="2" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
