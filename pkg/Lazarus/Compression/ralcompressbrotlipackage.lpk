<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RALCompressBrotliPackage"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\..\src\others\pascal_brotli;..\..\..\src\compress\brotli"/>
        <ObjectPath Value="$(PkgDir)\..\..\..\src\others\pascal_brotli\static_libs\lazarus\$(TargetCPU)_$(TargetOS)"/>
        <UnitOutputDirectory Value="..\..\..\compiled\lazarus\$(TargetCPU)-$(TargetOS)\ralcompressbrotlipackage"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | Brotli compression"/>
    <Version Major="2"/>
    <Files Count="3">
      <Item1>
        <Filename Value="..\..\..\src\others\pascal_brotli\brotlilib.pas"/>
        <UnitName Value="brotlilib"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\others\pascal_brotli\brotlistream.pas"/>
        <UnitName Value="brotlistream"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\compress\brotli\RALCompressBrotli.pas"/>
        <UnitName Value="RALCompressBrotli"/>
      </Item3>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="PascalRAL"/>
        <MinVersion Major="2" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
