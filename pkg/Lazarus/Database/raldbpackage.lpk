<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RALDBPackage"/>
    <Type Value="RunTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\..\src\database"/>
        <UnitOutputDirectory Value="..\..\..\compiled\lazarus\$(TargetCPU)-$(TargetOS)\raldbpackage"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | DBWare"/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\database\RALDBBase.pas"/>
        <UnitName Value="RALDBBase"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\database\RALDBPool.pas"/>
        <UnitName Value="RALDBPool"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\database\RALDBSQLCache.pas"/>
        <UnitName Value="RALDBSQLCache"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\database\RALDBConnection.pas"/>
        <UnitName Value="RALDBConnection"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\database\RALDBModule.pas"/>
        <UnitName Value="RALDBModule"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="ralstoragepackage"/>
        <MinVersion Major="2" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
