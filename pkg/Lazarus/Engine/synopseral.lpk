        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | mORMot2 engine"/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\engine\synopse\RALSynopseServer.pas"/>
        <UnitName Value="RALSynopseServer"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\engine\synopse\RALSynopseClient.pas"/>
        <UnitName Value="RALSynopseClient"/>
