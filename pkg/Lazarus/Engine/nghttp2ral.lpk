<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="NgHttp2RAL"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\..\src\bindings;..\..\..\src\engine\nghttp2"/>
        <UnitOutputDirectory Value="..\..\..\compiled\lazarus\$(TargetCPU)-$(TargetOS)\nghttp2ral"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="PascalRAL | HTTP/2 server and client on nghttp2"/>
    <Version Major="2"/>
    <Files Count="5">
      <Item1>
        <Filename Value="..\..\..\src\engine\nghttp2\RALNgHttp2Server.pas"/>
        <UnitName Value="RALNgHttp2Server"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\engine\nghttp2\RALNgHttp2Client.pas"/>
        <UnitName Value="RALNgHttp2Client"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\engine\nghttp2\RALNgHttp2Reg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALNgHttp2Reg"/>
      </Item3>
      <Item4>
        <Filename Value="nghttp2ral.lrs"/>
        <Type Value="LRS"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\bindings\nghttp2.pas"/>
        <UnitName Value="nghttp2"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="3">
      <Item1>
        <PackageName Value="PascalRAL"/>
        <MinVersion Major="2" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="RALNetPackage"/>
        <MinVersion Major="2" Valid="True"/>
      </Item2>
      <Item3>
        <PackageName Value="FCL"/>
      </Item3>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
