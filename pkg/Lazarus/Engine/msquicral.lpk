<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="MsQuicRAL"/>
    <Type Value="RunAndDesignTime"/>
    <AddToProjectUsesSection Value="True"/>
    <Author Value="OpenSourceCommunityBrasil"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\src\base;..\..\src\utils;..\..\src\engine\msquic;..\..\..\src\engine\msquic"/>
        <UnitOutputDirectory Value="..\..\..\compiled"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
      <Other>
        <Verbosity>
          <ShowLineNum Value="True"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="Package for installing MsQuic (QUIC, RFC 9000) engine components for PascalRAL."/>
    <Version Major="1" Minor="1"/>
    <Files Count="5">
      <Item1>
        <Filename Value="MsQuicRAL.lrs"/>
        <Type Value="LRS"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\src\engine\msquic\MsQuic.pas"/>
        <UnitName Value="MsQuic"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\..\src\engine\msquic\RALMsQuicClient.pas"/>
        <UnitName Value="RALMsQuicClient"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\..\src\engine\msquic\RALMsQuicRegister.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RALMsQuicRegister"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\..\src\engine\msquic\RALMsQuicServer.pas"/>
        <UnitName Value="RALMsQuicServer"/>
      </Item5>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="PascalRAL"/>
        <MinVersion Major="1" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
