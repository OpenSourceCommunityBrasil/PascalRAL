package RALHostingContainerPackage;

{$R *.res}
{$R 'RALHostingContainerPackage.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Hosting: service container'}
{$IMPLICITBUILD ON}

requires
  PascalRAL;

contains
  RALServiceContainer in '..\..\..\src\hosting\container\RALServiceContainer.pas',
  RALServiceInject in '..\..\..\src\hosting\container\RALServiceInject.pas',
  RALContainerReg in '..\..\..\src\hosting\container\RALContainerReg.pas';

end.
