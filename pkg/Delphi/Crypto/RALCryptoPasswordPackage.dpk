package RALCryptoPasswordPackage;

{$R *.res}
{$R 'RALCryptoPasswordPackage.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Password hashing: Argon2id, bcrypt, scrypt, PBKDF2'}
{$IMPLICITBUILD ON}

requires
  PascalRAL;

contains
  RALArgon2 in '..\..\..\src\crypto\password\RALArgon2.pas',
  RALScrypt in '..\..\..\src\crypto\password\RALScrypt.pas',
  RALPassword in '..\..\..\src\crypto\password\RALPassword.pas',
  RALCryptoPasswordReg in '..\..\..\src\crypto\password\RALCryptoPasswordReg.pas';

end.
