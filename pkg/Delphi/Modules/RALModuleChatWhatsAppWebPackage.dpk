package RALModuleChatWhatsAppWebPackage;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Chat channel: WhatsApp Web (no official API)'}
{$IMPLICITBUILD ON}

requires
  PascalRAL,
  RALModuleChatPackage,
  RALNetPackage,
  RALModuleWebSocketPackage,
  RALCryptoCurvesPackage,
  RALModuleProtobufPackage;

contains
  RALWhatsAppCrypto in '..\..\..\src\modules\chat\whatsappweb\RALWhatsAppCrypto.pas',
  RALWhatsAppProto in '..\..\..\src\modules\chat\whatsappweb\RALWhatsAppProto.pas',
  RALWhatsAppBinary in '..\..\..\src\modules\chat\whatsappweb\RALWhatsAppBinary.pas',
  RALWhatsAppMedia in '..\..\..\src\modules\chat\whatsappweb\RALWhatsAppMedia.pas',
  RALWhatsAppNoise in '..\..\..\src\modules\chat\whatsappweb\RALWhatsAppNoise.pas',
  RALWhatsAppSignal in '..\..\..\src\modules\chat\whatsappweb\RALWhatsAppSignal.pas',
  RALQRCode in '..\..\..\src\modules\chat\whatsappweb\RALQRCode.pas',
  RALChatWhatsAppWeb in '..\..\..\src\modules\chat\whatsappweb\RALChatWhatsAppWeb.pas';

end.
