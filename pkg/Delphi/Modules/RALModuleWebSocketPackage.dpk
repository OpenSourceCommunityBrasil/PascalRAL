package RALModuleWebSocketPackage;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$R 'RALModuleWebSocketPackage.dcr'}
{$DESCRIPTION 'PascalRAL | WebSocket routes, client and hubs'}
{$IMPLICITBUILD ON}

requires
  PascalRAL,
  RALNetPackage;

contains
  RALWebSocketServer in '..\..\..\src\modules\websocket\RALWebSocketServer.pas',
  RALWebSocketClient in '..\..\..\src\modules\websocket\RALWebSocketClient.pas',
  RALWebSocketHub in '..\..\..\src\modules\websocket\RALWebSocketHub.pas',
  RALWebSocketHubClient in '..\..\..\src\modules\websocket\RALWebSocketHubClient.pas',
  RALModuleWebSocketReg in '..\..\..\src\modules\websocket\RALModuleWebSocketReg.pas';

end.
