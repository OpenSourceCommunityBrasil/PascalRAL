package RALSOAPPackage;

{$R *.res}
{$R 'RALSOAP.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | SOAP'}
{$IMPLICITBUILD ON}

requires
  rtl,
  dbrtl,
  vcl,
  PascalRALDsgn,
  RALDBPackage,
  RALXMLPackage;

contains
  RALSOAPTypes in '..\..\..\src\modules\soap\RALSOAPTypes.pas',
  RALSOAPModule in '..\..\..\src\modules\soap\RALSOAPModule.pas',
  RALWSDLExporter in '..\..\..\src\modules\soap\RALWSDLExporter.pas',
  RALSOAPClient in '..\..\..\src\modules\soap\RALSOAPClient.pas',
  RALSOAPActions in '..\..\..\src\modules\soap\RALSOAPActions.pas',
  RALSOAPReg in '..\..\..\src\modules\soap\RALSOAPReg.pas';

end.
