package RALModuleMailPackage;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Mail module (MIME, SMTP client and server, queue, DKIM)'}
{$IMPLICITBUILD ON}

requires
  PascalRAL,
  RALNetPackage,
  RALCryptoCurvesPackage,
  RALHostingJobQueuePackage;

contains
  RALMailMIME in '..\..\..\src\modules\mail\RALMailMIME.pas',
  RALDKIM in '..\..\..\src\modules\mail\RALDKIM.pas',
  RALSMTPClient in '..\..\..\src\modules\mail\RALSMTPClient.pas',
  RALMailQueue in '..\..\..\src\modules\mail\RALMailQueue.pas',
  RALSMTPServer in '..\..\..\src\modules\mail\RALSMTPServer.pas',
  RALDNS in '..\..\..\src\modules\mail\RALDNS.pas',
  RALMailVerifier in '..\..\..\src\modules\mail\RALMailVerifier.pas',
  RALMailTransport in '..\..\..\src\modules\mail\RALMailTransport.pas',
  RALIMAPClient in '..\..\..\src\modules\mail\RALIMAPClient.pas',
  RALPOP3Client in '..\..\..\src\modules\mail\RALPOP3Client.pas',
  RALSMIME in '..\..\..\src\modules\mail\RALSMIME.pas',
  RALMailStore in '..\..\..\src\modules\mail\RALMailStore.pas',
  RALMailServerBase in '..\..\..\src\modules\mail\RALMailServerBase.pas',
  RALPOP3Server in '..\..\..\src\modules\mail\RALPOP3Server.pas',
  RALIMAPServer in '..\..\..\src\modules\mail\RALIMAPServer.pas',
  RALOpenPGP in '..\..\..\src\modules\mail\RALOpenPGP.pas';

end.
