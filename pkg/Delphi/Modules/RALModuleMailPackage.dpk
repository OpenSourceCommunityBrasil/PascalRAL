package RALModuleMailPackage;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Mail module (MIME, SMTP client and server, queue, DKIM)'}
{$IMPLICITBUILD ON}

requires
  PascalRAL,
  RALNetPackage,
  RALCryptoCurvesPackage,
  RALHostingJobQueuePackage;

contains
  RALMailMIME in '..\..\..\src\modules\mail\RALMailMIME.pas',
  RALDKIM in '..\..\..\src\modules\mail\RALDKIM.pas',
  RALSMTPClient in '..\..\..\src\modules\mail\RALSMTPClient.pas',
  RALMailQueue in '..\..\..\src\modules\mail\RALMailQueue.pas',
  RALSMTPServer in '..\..\..\src\modules\mail\RALSMTPServer.pas';

end.
