package RALModuleChatPackage;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Chat module (message model, bot, webhook, outbound queue)'}
{$IMPLICITBUILD ON}

requires
  PascalRAL;

contains
  RALChatMessage in '..\..\..\src\modules\chat\RALChatMessage.pas',
  RALChatVerify in '..\..\..\src\modules\chat\RALChatVerify.pas',
  RALChatHttp in '..\..\..\src\modules\chat\RALChatHttp.pas',
  RALChatChannel in '..\..\..\src\modules\chat\RALChatChannel.pas',
  RALChatOutbox in '..\..\..\src\modules\chat\RALChatOutbox.pas',
  RALChatStore in '..\..\..\src\modules\chat\RALChatStore.pas',
  RALChatBot in '..\..\..\src\modules\chat\RALChatBot.pas',
  RALChatWebhook in '..\..\..\src\modules\chat\RALChatWebhook.pas',
  RALChatGateway in '..\..\..\src\modules\chat\RALChatGateway.pas',
  RALChatFlow in '..\..\..\src\modules\chat\RALChatFlow.pas';

end.
