package PascalRAL;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'PascalRAL | Core'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl;

contains
  RALTypes in '..\..\src\core\RALTypes.pas',
  RALConsts in '..\..\src\core\RALConsts.pas',
  RALCustomObjects in '..\..\src\core\RALCustomObjects.pas',
  RALParams in '..\..\src\core\RALParams.pas',
  RALRequest in '..\..\src\core\RALRequest.pas',
  RALResponse in '..\..\src\core\RALResponse.pas',
  RALRoutes in '..\..\src\core\RALRoutes.pas',
  RALPlugin in '..\..\src\core\RALPlugin.pas',
  RALAuthBase in '..\..\src\core\RALAuthBase.pas',
  RALServer in '..\..\src\core\RALServer.pas',
  RALClient in '..\..\src\core\RALClient.pas',
  RALTools in '..\..\src\common\RALTools.pas',
  RALStream in '..\..\src\common\RALStream.pas',
  RALThreadSafe in '..\..\src\common\RALThreadSafe.pas',
  RALJson in '..\..\src\common\RALJson.pas',
  RALMIMETypes in '..\..\src\common\RALMIMETypes.pas',
  RALUrlCoder in '..\..\src\common\RALUrlCoder.pas',
  RALMultipartCoder in '..\..\src\common\RALMultipartCoder.pas',
  RALNetwork in '..\..\src\common\RALNetwork.pas',
  RALBase64 in '..\..\src\common\RALBase64.pas',
  RALHexadecimal in '..\..\src\common\RALHexadecimal.pas',
  RALResponsePages in '..\..\src\common\RALResponsePages.pas',
  RALExternalsLibraries in '..\..\src\common\RALExternalsLibraries.pas',
  RALQuicFrame in '..\..\src\common\RALQuicFrame.pas',
  RALCompress in '..\..\src\compress\RALCompress.pas',
  RALCompressZLib in '..\..\src\compress\RALCompressZLib.pas',
  RALHashBase in '..\..\src\crypto\RALHashBase.pas',
  RALHashes in '..\..\src\crypto\RALHashes.pas',
  RALMD5 in '..\..\src\crypto\RALMD5.pas',
  RALSHA1 in '..\..\src\crypto\RALSHA1.pas',
  RALSHA2_32 in '..\..\src\crypto\RALSHA2_32.pas',
  RALSHA2_64 in '..\..\src\crypto\RALSHA2_64.pas',
  RALCRC32 in '..\..\src\crypto\RALCRC32.pas',
  RALCripto in '..\..\src\crypto\RALCripto.pas',
  RALCriptoAES in '..\..\src\crypto\RALCriptoAES.pas',
  RALCriptoOpenSSL in '..\..\src\crypto\RALCriptoOpenSSL.pas',
  RALOpenSSL in '..\..\src\crypto\RALOpenSSL.pas',
  RALBigInt in '..\..\src\crypto\RALBigInt.pas',
  RALASN1 in '..\..\src\crypto\RALASN1.pas',
  RALRSA in '..\..\src\crypto\RALRSA.pas',
  RALX509 in '..\..\src\crypto\RALX509.pas',
  RALJWS in '..\..\src\crypto\RALJWS.pas',
  RALToken in '..\..\src\crypto\RALToken.pas',
  RALSecurity in '..\..\src\plugins\RALSecurity.pas',
  RALCORS in '..\..\src\plugins\RALCORS.pas',
  RALContent in '..\..\src\plugins\RALContent.pas',
  RALConcurrency in '..\..\src\plugins\RALConcurrency.pas';

end.
